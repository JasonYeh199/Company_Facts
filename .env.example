# SEC requires a descriptive product name and a monitored contact address.
SEC_USER_AGENT=Company Facts Research contact@example.com
DATABASE_URL=postgresql+psycopg://company_facts:company_facts@db:5432/company_facts
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
API_INTERNAL_BASE_URL=http://api:8000/api/v1
API_CORS_ORIGINS=http://localhost:3000
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
DATA_DIR=/data/sec
SYNC_POLL_SECONDS=30
TIINGO_API_TOKEN=
TIINGO_REQUESTS_PER_HOUR=45
TIINGO_HISTORY_YEARS=10
TIINGO_OVERLAP_DAYS=10
